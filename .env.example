# Copie este archivo como .env (en la raiz del proyecto) y ponga sus valores reales.
# .env esta en .gitignore: NUNCA se sube a GitHub.
# Lo leen tanto "mvnw spring-boot:run" como "docker compose".
# No use comillas ni espacios alrededor del "=".

# ---------- Base de datos ----------
# mysql | postgresql
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crud_usuarios
DB_USERNAME=root
DB_PASSWORD=1234567
# Solo PostgreSQL: disable (local) | require (Supabase)
DB_SSL_MODE=disable

# Ejemplo PostgreSQL local:
# DB_ENGINE=postgresql
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=su_clave_pg

# Ejemplo Supabase (Connect > Session pooler):
# DB_ENGINE=postgresql
# DB_HOST=aws-0-us-east-1.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USERNAME=postgres.xxxxxxxxxxxxxxxxxxxx
# DB_PASSWORD=su_clave_supabase
# DB_SSL_MODE=require

# ---------- Correo (Gmail) ----------
SMTP_USERNAME=su_correo@gmail.com
# Clave de aplicacion de 16 letras de https://myaccount.google.com/apppasswords (sin espacios)
SMTP_PASSWORD=abcdefghijklmnop
SMTP_FROM_ADDRESS=su_correo@gmail.com

# ---------- JWT ----------
# Genere uno con:  openssl rand -base64 48
JWT_SECRET=ZGV2ZWxvcG1lbnQtb25seS1qd3Qtc2VjcmV0LW11c3QtYmUtcmVwbGFjZWQ=
